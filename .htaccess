# Used when the whole project folder is web-reachable (e.g. XAMPP htdocs/game).
# Everything is forwarded into public/, so src/, config/, database/, views/,
# .env etc. can never be requested directly.
#
# If you can point Apache's DocumentRoot at public/ instead, this file is unused.

RewriteEngine On
RewriteRule ^(.*)$ public/$1 [L]
