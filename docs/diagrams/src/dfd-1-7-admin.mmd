%% DFD level 1, process 7.0: administer the system.
flowchart LR
  A["Administrator"]:::entity
  X3("3.0<br/>Award progression"):::external

  P71("7.1<br/>Show stats<br/>and analytics"):::process
  P72("7.2<br/>Manage<br/>players"):::process
  P73("7.3<br/>Edit<br/>questions"):::process
  P74("7.4<br/>Import CSV"):::process
  P75("7.5<br/>Review<br/>security log"):::process
  P76("7.6<br/>Export data"):::process
  P77("7.7<br/>Change admin<br/>password"):::process

  D1[("D1 users")]:::store
  D2[("D2 admin")]:::store
  D3[("D3 questions")]:::store
  D4[("D4 runs, run_gates,<br/>run_answers")]:::store
  D6[("D6 items, inventory")]:::store
  D11[("D11 security_log")]:::store

  D1 -- "players" --> P71
  D4 -- "runs, answers" --> P71
  D3 -- "hardest questions" --> P71
  P71 -- "stats, activity,<br/>analytics" --> A

  A -- "new player, coins, level<br/>or player to delete" --> P72
  P72 <-- "players" --> D1
  P72 -- "starting balance<br/>(admin_grant)" --> X3
  P72 -- "starter power-ups" --> D6
  P72 -- "player list" --> A

  A -- "filters, question,<br/>archive or restore" --> P73
  P73 <-- "questions" --> D3
  D4 -- "answer counts,<br/>accuracy" --> P73
  P73 -- "question list, errors" --> A

  A -- "CSV text" --> P74
  D3 -- "existing prompts" --> P74
  P74 -- "valid rows<br/>(all or nothing)" --> D3
  P74 -- "added, skipped,<br/>row errors" --> A

  D11 -- "last 100 events" --> P75
  P75 -- "security log" --> A

  D1 -- "players" --> P76
  D4 -- "runs" --> P76
  D3 -- "questions" --> P76
  D6 -- "items" --> P76
  P76 -- "JSON export" --> A

  A -- "current and<br/>new password" --> P77
  P77 <-- "password hash" --> D2

  classDef entity fill:#f1f5f9,stroke:#334155,stroke-width:1.5px,color:#0f172a
  classDef process fill:#eef2ff,stroke:#4f46e5,stroke-width:2px,color:#1e1b4b
  classDef external fill:#ffffff,stroke:#4f46e5,stroke-width:1.5px,stroke-dasharray:5 4,color:#1e1b4b
  classDef store fill:#fff7ed,stroke:#c2410c,stroke-width:1.5px,color:#431407
