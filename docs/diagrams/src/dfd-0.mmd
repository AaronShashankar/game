---
config:
  layout: elk
---
%% DFD level 0: the seven main processes, the data stores, and the flows between them.
flowchart LR
  G["Guest"]:::entity
  P["Player"]:::entity
  A["Administrator"]:::entity

  P1("1.0<br/>Manage accounts<br/>and sessions"):::process
  P2("2.0<br/>Play a maze run"):::process
  P3("3.0<br/>Award progression<br/>and daily rewards"):::process
  P4("4.0<br/>Shop and<br/>inventory"):::process
  P5("5.0<br/>Track learning"):::process
  P6("6.0<br/>Competition and<br/>achievements"):::process
  P7("7.0<br/>Administer<br/>the system"):::process

  D1[("D1 users")]:::store
  D2[("D2 admin")]:::store
  D3[("D3 questions")]:::store
  D4[("D4 runs, run_gates,<br/>run_answers")]:::store
  D5[("D5 ledger")]:::store
  D6[("D6 items, inventory")]:::store
  D7[("D7 question_reviews")]:::store
  D8[("D8 daily_mazes")]:::store
  D9[("D9 weekly_settlements,<br/>weekly_rewards")]:::store
  D10[("D10 user_achievements")]:::store
  D11[("D11 security_log")]:::store

  %% 1.0 accounts
  G -- "sign-up details, credentials" --> P1
  P -- "credentials, profile changes" --> P1
  P1 -- "session, profile" --> P
  A -- "admin credentials" --> P1
  P1 -- "admin session" --> A
  P1 <-- "player accounts" --> D1
  D2 -- "admin accounts" --> P1
  P1 -- "login events" --> D11
  P1 -- "starter coins" --> P3
  P1 -- "starter power-ups" --> D6

  %% 2.0 play
  P -- "start, answers, power-ups,<br/>pickups, finish" --> P2
  P2 -- "run state, questions,<br/>feedback, summary" --> P
  D3 -- "questions" --> P2
  P2 <-- "runs, gates, answers" --> D4
  D8 -- "daily seed" --> P2
  D7 -- "due reviews" --> P2
  P2 -- "power-up used" --> D6
  P2 -- "rejected events" --> D11
  P2 -- "rewards, penalties" --> P3
  P2 -- "answer outcome" --> P5
  P2 -- "run outcome" --> P6

  %% 3.0 progression
  P -- "check-in, spin" --> P3
  P3 -- "wallet, streak, prize" --> P
  P3 <-- "ledger entries" --> D5
  P3 <-- "coins, XP, level, streak" --> D1
  P3 <-- "streak freezes, prizes" --> D6

  %% 4.0 shop
  P -- "purchase, equip" --> P4
  P4 -- "catalogue, inventory" --> P
  P4 <-- "items, quantities" --> D6
  P4 -- "coins to spend" --> P3
  P4 -- "equipped skin and theme" --> D1

  %% 5.0 learning
  P5 <-- "review boxes" --> D7
  D4 -- "answer history" --> P5
  P5 -- "mastery, reviews due" --> P

  %% 6.0 competition
  G -- "leaderboard request,<br/>challenge code" --> P6
  P6 -- "leaderboards,<br/>challenge details" --> G
  P6 -- "rankings, achievements,<br/>weekly winners" --> P
  D1 -- "players" --> P6
  D4 -- "finished runs" --> P6
  D5 -- "weekly XP" --> P6
  P6 <-- "settled weeks, winners" --> D9
  P6 <-- "unlocks" --> D10
  P6 -- "weekly prizes" --> P3

  %% 7.0 admin
  A -- "new players, questions, CSV" --> P7
  P7 -- "stats, analytics, logs, export" --> A
  P7 <-- "players" --> D1
  P7 <-- "questions" --> D3
  D4 -- "run and answer stats" --> P7
  D11 -- "security events" --> P7
  P7 -- "admin grants" --> P3

  classDef entity fill:#f1f5f9,stroke:#334155,stroke-width:1.5px,color:#0f172a
  classDef process fill:#eef2ff,stroke:#4f46e5,stroke-width:2px,color:#1e1b4b
  classDef store fill:#fff7ed,stroke:#c2410c,stroke-width:1.5px,color:#431407
